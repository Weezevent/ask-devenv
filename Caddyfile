# ask-devenv — Caddy reverse proxy (local HTTPS via mkcert)
#
# Domains:
#   https://api.ask.local   → ask-backend  :8000
#   https://ask.local       → ask-frontend :3000
#
# Run setup.sh once to generate certs with mkcert, then:
#   docker compose up caddy

api.ask.local {
    tls /certs/ask.local.pem /certs/ask.local-key.pem

    reverse_proxy ask:8000
}

ask.local {
    tls /certs/ask.local.pem /certs/ask.local-key.pem

    reverse_proxy frontend:3000
}
