# =============================================================================
# ask-devenv — local environment variables
# Copy to .env and fill in the values.
# =============================================================================

# ---------------------------------------------------------------------------
# AWS / Bedrock
# ---------------------------------------------------------------------------
# Leave blank if using IRSA / AWS CLI profile instead of static credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
MEM0_EXTRACTION_MODEL=mistral.mistral-7b-instruct-v0:2

# ---------------------------------------------------------------------------
# Keycloak (shared accounts.weezevent.com)
# ---------------------------------------------------------------------------
# Use the accounts-dev realm for local dev — no local Keycloak instance needed.
ACCOUNTS_URL=https://accounts.weezevent.com/realms/accounts-dev
ACCOUNTS_CLIENT_IDENTIFIER=ask_backend_local
# Secret for the confidential Keycloak client (ask_backend_local).
# Get it from the dev Keycloak admin or a teammate.
ACCOUNTS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Qdrant — set by docker-compose, override if needed
# ---------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ---------------------------------------------------------------------------
# Gigz upstream APIs
# ---------------------------------------------------------------------------
GIGZ_LOGS_BASE_URL=https://api.staging.weezevent.com/logs
GIGZ_LOGS_TOKEN=

GIGZ_FOREST_BASE_URL=https://api.staging.weezevent.com/forest
GIGZ_FOREST_USER=
GIGZ_FOREST_PASSWORD=

# ---------------------------------------------------------------------------
# Observability (optional locally)
# ---------------------------------------------------------------------------
SENTRY_DSN=
