# =============================================================================
# ask-devenv — local environment variables
# Copy to .env and fill in the values before running setup.sh.
# =============================================================================

# GitHub personal access token — required to clone private Weezevent repos.
# Needs: repo (read) + read:packages (for @weezevent/nacre npm package)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# AWS / Bedrock
# ---------------------------------------------------------------------------
# Leave blank if you use a named AWS CLI profile (~/.aws/credentials).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
MEM0_EXTRACTION_MODEL=mistral.mistral-7b-instruct-v0:2

# ---------------------------------------------------------------------------
# Keycloak — shared dev realm, no local instance needed
# ---------------------------------------------------------------------------
ACCOUNTS_URL=https://accounts.weezevent.com/realms/accounts-dev
ACCOUNTS_CLIENT_IDENTIFIER=ask_backend_local
# Confidential client secret for ask_backend_local — ask a teammate.
ACCOUNTS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Gigz upstream APIs (staging endpoints are safe for local dev)
# ---------------------------------------------------------------------------
GIGZ_LOGS_BASE_URL=https://api.staging.weezevent.com/logs
GIGZ_LOGS_TOKEN=

GIGZ_FOREST_BASE_URL=https://api.staging.weezevent.com/forest
GIGZ_FOREST_USER=
GIGZ_FOREST_PASSWORD=

# ---------------------------------------------------------------------------
# Observability (optional locally)
# ---------------------------------------------------------------------------
SENTRY_DSN=
